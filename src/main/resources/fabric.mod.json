{
  "schemaVersion": 1,
  "id": "vanish-client",
  "version": "${version}",
  "name": "Vanish Client",
  "description": "Meteor addon: aim assist, trails, kill effects, target ESP and hand shaders.",
  "authors": ["Vanish"],
  "icon": "assets/template/icon.png",
  "environment": "client",
  "entrypoints": {
    "meteor": ["com.vanishclient.VanishClientAddon"]
  },
  "custom": {
    "meteor-client:color": "60,160,255",
    "modmenu": { "parent": { "id": "meteor-client" } }
  },
  "depends": {
    "java": ">=${jdk_version}",
    "minecraft": "${minecraft_version}",
    "meteor-client": "*"
  }
}
